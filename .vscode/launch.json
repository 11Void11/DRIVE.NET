{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Safe Cruise: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--port", "8000"],
      "python": "${workspaceFolder}/.venv.nosync/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Safe Cruise: Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "dashboard.py", "--server.port", "8501"],
      "python": "${workspaceFolder}/.venv.nosync/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Safe Cruise: train model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train_full_model.py",
      "python": "${workspaceFolder}/.venv.nosync/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
